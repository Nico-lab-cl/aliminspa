generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  celular   String
  ciudad    String
  proyecto  String?
  // Respuesta de "¿Cómo nos conociste?". Nullable porque los leads anteriores
  // a agosto de 2026 no la tienen: hasta entonces el formulario preguntaba
  // pero la respuesta nunca se guardaba.
  como_conocio String?
  fuente    String   @default("web")
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  utm_term     String?
  // Ley 21.719: prueba del consentimiento. Nullable porque las filas
  // anteriores a octubre de 2026 no lo registraban.
  consentimiento_contacto  Boolean?
  consentimiento_marketing Boolean?
  consentimiento_at        DateTime?
  politica_version         String?
  consentimiento_origen    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  // Ley 21.719: cuándo y desde dónde se suscribió, y cuándo se dio de baja.
  consentimiento_at     DateTime?
  politica_version      String?
  consentimiento_origen String?
  baja_at               DateTime?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model Booking {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  celular   String
  proyecto  String
  fecha     DateTime
  hora      String
  // Lote elegido en el mapa 3D, con el formato "Etapa 2 · Lote 14". Nullable
  // porque el calendario clásico (/reunion) agenda sin elegir un lote.
  lote      String?
  // Modalidad de la visita. Hoy siempre "Visita en terreno, El Tabo"; queda
  // como campo por si más adelante se ofrece videollamada u oficina.
  modalidad String?
  status    String   @default("confirmed")
  // Ley 21.719: prueba del consentimiento (ver Lead).
  consentimiento_contacto  Boolean?
  consentimiento_marketing Boolean?
  consentimiento_at        DateTime?
  politica_version         String?
  consentimiento_origen    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bookings")
}

// Solicitudes de derechos de la Ley 21.719 que llegan desde
// /privacidad/derechos. La ley da 30 días corridos para responder
// (prorrogables una vez); el bloqueo temporal, 2 días hábiles.
model SolicitudDerecho {
  id            String    @id @default(cuid())
  // acceso | rectificacion | supresion | oposicion | portabilidad | bloqueo | baja_comunicaciones
  tipo          String
  nombre        String
  email         String
  celular       String?
  detalle       String?   @db.Text
  // pendiente | en_proceso | respondida | rechazada
  estado        String    @default("pendiente")
  vence_el      DateTime
  respuesta     String?   @db.Text
  respondida_at DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([estado])
  @@index([email])
  @@map("solicitudes_derechos")
}

model Sorteo {
  id           String   @id @default("current")
  participants String   @db.Text // JSON array of participant usernames
  winners      String   @db.Text // JSON array of winner usernames
  status       String   @default("pending") // pending | active | finished
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sorteos")
}

model PollVote {
  id         String   @id @default(cuid())
  pollId     String   @map("poll_id")      // Identificador de la encuesta (ej. "lomas-del-mar-beneficio")
  optionId   Int      @map("option_id")    // ID de la opción elegida (1, 2, 3...)
  optionText String   @map("option_text")  // Texto de la opción para referencia
  fingerprint String? @map("fingerprint")  // Hash del IP para evitar duplicados sin guardar datos personales
  userAgent  String?  @map("user_agent")
  proyecto   String?                       // Proyecto asociado (ej. "Lomas del Mar")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([pollId])
  @@index([pollId, fingerprint])
  @@map("poll_votes")
}
